---
import Header from "../Header.astro";

interface Props {
    title: string;
}

const {title} = Astro.props;
---

<div class="background">
    <Header borderSize="1px"/>
    <div class="auth-container">
        <h1>{title}</h1>
        <div class="auth-form">
            <slot/>
        </div>
        <button>Submit</button>
    </div>
    <div class="auth-popup">
        <h3>ⓘ Error!</h3>
        <p>Something went wrong!</p>
    </div>
</div>

<style is:global>
    html, body {
        height: 100%;
    }
    body {
        margin: 0;
        background: linear-gradient(to bottom, #201b29, #2e2a39);
        overflow-x: hidden;
    }
    .background {
        height: 100%;
    }
    .auth-popup {
        position: absolute;
        bottom: 4%;
        right: -100%;
        width: 270px;
        height: 120px;
        background-color: #e5394a;
        border-radius: 8px;
        border: 3px solid #ad0f1f;
        display: flex;
        flex-direction: column;
        opacity: 0;
        transition: opacity 0.5s ease-in-out, right 0.7s ease-in-out;
    }
    .auth-popup.show {
        opacity: 100%;
        right: 2%;
    }
    .auth-popup * {
        margin-left: 25px;
    }
    .auth-popup h3 {
        font-family: 'Montserrat';
        color: #d1c7e0;
    }
    .auth-popup p {
        margin-top: 0px;
        color: #dadada;
        font-family: 'Roboto';
    }
    .auth-container {
        background-color: #2e2a39;
        width: 500px;
        height: 600px;
        margin: 80px auto 0;
        border: 2px solid #8e7cc3;
        border-radius: 25px;
        box-shadow: 0 0 30px #00000080;
        align-items: center;
        display: flex;
        justify-content: center;
        flex-direction: column;
        flex-wrap: wrap;
    }
    .auth-container h1 {
        margin-top: 10%;
        color: #d1c7e0;
        text-align: center;
    }
    .auth-form {
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        font-family: 'Roboto';
        width: 85%;
    }
    .auth-form p {
        color: #d1c7e0;
    }
    .auth-form input {
        background-color: #231f2e;
        border: none;
        padding: 12px;
        width: 70%;
        border-radius: 5px;
        color: #d1c7e0;
        font-size: 16px;
        margin-bottom: 20px;
        border: 1px solid #d1c7e0;
        border-color: #d1c7e0;
        outline: none;
        transition: box-shadow 0.3s ease-in-out, border-color 0.3s ease-in-out;
    }
    .auth-form input:hover {
        box-shadow: 0 0 20px #000;
    }
    .auth-form input:focus {
        border-color: #8e7cc3;
        box-shadow: 0 0 20px #000;
    }
    .auth-container button {
        background-color: #8e7cc3;
        border: none;
        padding: 12px;
        width: 40%;
        height: 8%;
        border-radius: 5px;
        color: #d1c7e0;
        font-size: 16px;
        font-family: 'Roboto';
        cursor: pointer;
        transition: box-shadow 0.15s ease-in-out;
        margin-bottom: 10%;
    }
    .auth-container button:hover {
        box-shadow: 0 0 20px #000;
    }
</style>