---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
---

<Layout title="Taskzilla | Dasboard">
    <div class="panel">
        <div class="header-box">
        </div>
        <div class="page-content">
            <h1>Dashboard</h1>
            <div class="task-container">
                <div class="task-box">
                    <h3 class="task-name">Name</h3>
                    <p class="task-description">Description</p>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style is:global>
	html, body {
		height: 100%;
        width: 100%;
		display: flex;
    }
    body {
        margin: 0;
        background-color: bisque;
    }
    .panel {
        display: flex;
        width: 100%;
        background-image:linear-gradient(to bottom, #201b29, #2e2a39);
        display: flex;
        flex-direction: column;
    }
    .page-content {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
        margin-left: 8%;
    }
    .panel h1 {
        color: white;
        text-decoration: bold;
        font-family: 'Montserrat';
        margin-top: 70px;
    }
    .header-box {
        width: 100%;
    }
    .task-container {
        margin-top: 2%;
        display: flex;
        flex-direction: column;
        height: 85%;
        width: 40%;
    }
    .task-box {
        background-color: white;
        width: 50%;
        height: auto;
        border-radius: 12px;
        margin-bottom: 40px;
        transition: box-shadow 0.14s ease-in-out;
        cursor: pointer;
    }
    .task-completed-symbol {
        color: red;
        border: 2px solid red;
        border-radius: 10px;
        padding: 5px;
        width: 20%;
    }
    .task-box:hover {
        box-shadow: 0 0 100px #000;
    }
    .task-name {
        font-family: 'Rubik';
    }
    .task-description, .task-completed-symbol {
        font-family: 'Roboto';
    }
    .task-name, .task-description, .task-completed-symbol {
        margin-left: 20px;
    }
    .background {
        height: 100%;
    }
</style>

<script>
    import { getTasks } from "../scripts/api-tasks.js";

    const token = document.cookie.split(";").find((c) => c.startsWith("token"))?.split("=")[1];
    if (!token) {
        window.location.replace("/")
    }

    const tasks = await getTasks(token!!);
    if (!tasks) {
        window.location.replace("/")
    }

    const taskContainer = document.querySelector('.task-container')!!;
    tasks!!.forEach(task => {
        const listBox = document.createElement('div');
        const listTitle = document.createElement('h3');
        const listSubtitle = document.createElement('p');
        listBox.classList.add('task-box');
        listTitle.classList.add('task-name');
        listSubtitle.classList.add('task-description');

        listTitle.innerHTML = task.name;
        listSubtitle.innerHTML = task.description;


        taskContainer.appendChild(listBox);
        listBox.appendChild(listTitle);
        listBox.appendChild(listSubtitle);

        if (task.completed) {
            const completedSymbol = document.createElement("p");
            completedSymbol.classList.add("task-completed-symbol");
            completedSymbol.innerHTML = "Completed";
            listBox.appendChild(completedSymbol);
        }
    });
</script>