---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

export const prerender = true;
---

<Layout title="Taskzilla">
	<div class="initial-background">
		<main>
			<div class ="central-box">
				<div class ="title-container">
					<span id="text" class="text-gradient unselectable"></span>
					<span id="cursor" class=" unselectable">_</span>
				</div>
				<p class="subtitle">A modern task manager for modern people</p> 
				<button class="get-started-button">Get started organizing your life</button>
			</div>
		</main>
	</div>
</Layout>

<style>
	main {
		margin: auto;
		padding: 1.5rem;
		max-width: 60ch;
		display: flex;
	}
	html, body {
		height: 100%;
	}
	body {
		margin: 0;
	}
	h1 {
		font-size: 3vw;
		font-weight: 800;
		margin: 0;
	}
	.initial-background {
		background-image:url("../../assets/images/mountain.jpg");
		background-size: 100%;
		background-position: center;
		background-attachment: fixed;
		width: 100%;
		height: 1500px;
		background-size: cover;
	}
	.central-box {
		display: inline-block;
		text-align: center;
		justify-content: center;
		align-items: center;
 		margin: 0 auto;
	}
	.subtitle {
		font-family: 'Roboto';
		color: white;
		font-size: 20px;
	}
	.title {
		display: inline-block;
		position: relative;
		overflow: hidden;
		border-bottom: 2px solid transparent;
		white-space: nowrap;
		animation: typing 1.5s steps(30, end) forwards;
	}
	.title-container {
		padding: 10px;
		color: white;
		font-family: 'Rubik';
		font-size: 58px;
	}
	#cursor {
		width: 100%;
		height: 100%;
		animation: blink 1.1s infinite;
		font-size: 38px;
		color: white;
	}
	.get-started-button {
		margin-top: 20px;
		border-color: transparent;
		background-image: var(--accent-gradient);
		color: white;
		border: none;
		border-radius: 5px;
		padding: 10px 20px;
		font-size: 20px;
		font-family: 'Roboto';
		cursor: pointer;
		transition: box-shadow 0.37s ease-in-out;
	}
	.get-started-button:hover {
		box-shadow: 0 0 20px #000;
	}
	@keyframes typing {
        from { width: 0; }
        to { width: 100% }
    }
	@keyframes blink {
		0% {
			opacity: 0;
		}
		50% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}
	.text-gradient {
		background-image: var(--accent-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-size: 400%;
		background-position: 0%;
	}
</style>

<script>
	const text = "Taskzilla";
	const speed = 150;

	let i = 0;
	const typing = setInterval(() => {
		document.getElementById("text")!!.textContent += text.charAt(i);
		i++;
		if (i === text.length) {
			clearInterval(typing);
		}
	}, speed);
</script>